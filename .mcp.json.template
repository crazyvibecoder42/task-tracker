{
  "_comment_setup": "Task Tracker MCP Configuration",
  "_comment_requirements": "Requires 'uv' installed (brew install uv). Deps auto-resolve via PEP 723 metadata in stdio_server.py.",
  "_comment_note": "Copy this file to .mcp.json (gitignored) and fill in your API key and user ID",

  "mcpServers": {
    "task-tracker": {
      "command": "uv",
      "args": ["run", "mcp-server/stdio_server.py"],
      "env": {
        "TASK_TRACKER_API_URL": "http://localhost:6001",
        "TASK_TRACKER_API_KEY": "GET_API_KEY_FROM_SETTINGS",
        "TASK_TRACKER_USER_ID": "YOUR_USER_ID"
      }
    }
  }
}
